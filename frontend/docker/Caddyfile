# Serves the built SPA inside the `web` container. TLS and security headers are
# applied by the edge Caddy in front of it (root Caddyfile).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
