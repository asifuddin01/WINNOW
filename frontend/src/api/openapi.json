  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted",
            "title": "Status",
            "default": "accepted"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Accepted"
      },
      "AuthOptions": {
        "properties": {
          "registration": {
            "type": "string",
            "enum": [
              "open",
              "invite_only",
              "closed"
            ],
            "title": "Registration"
          },
          "single_user": {
            "type": "boolean",
            "title": "Single User"
          },
          "needs_setup": {
            "type": "boolean",
            "title": "Needs Setup"
          },
          "email_enabled": {
            "type": "boolean",
            "title": "Email Enabled"
          }
        },
        "type": "object",
        "required": [
          "registration",
          "single_user",
          "needs_setup",
          "email_enabled"
        ],
        "title": "AuthOptions"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "CodeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CodeRequest"
      },
      "CsrfOut": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut"
      },
      "DisableTwoFactorRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "password",
          "code"
        ],
        "title": "DisableTwoFactorRequest"
      },
      "EmailRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
