{
  "openapi": "3.1.0",
  "info": {
    "title": "Winnow API",
    "summary": "Screening for systematic, scoping and rapid reviews.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "The process is up and serving requests. Touches no dependencies.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "The API can reach PostgreSQL and Redis. 503 names the dependency that failed.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Liveness"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          }
        },
        "type": "object",
        "required": [
          "checks"
        ],
        "title": "Readiness"
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "database",
          "redis"
        ],
        "title": "ReadinessChecks"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "ValidationProblem": {
        "additionalProperties": true,
        "properties": {
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "title",
          "status",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    }
  }
}
