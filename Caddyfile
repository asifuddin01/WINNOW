# Edge proxy (guide 4, 12.5). Development serves plain HTTP on :8080; production (Phase 9)
# sets SITE_ADDRESS to a domain and Caddy obtains HTTPS automatically.
{
	admin off
	auto_https off
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# HSTS only means something over HTTPS; never pin plain-HTTP development hosts.
	@https protocol https
	header @https Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

	# Swagger UI (development only; the API hides it in production) loads from jsDelivr.
	handle /api/docs* {
		header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; frame-ancestors 'none'"
		reverse_proxy api:8000 {
			# Server-sent events must not be buffered.
			flush_interval -1
		}
	}

	# Restoring a project backup (guide 8.16) is the one larger upload: MAX_BACKUP_MB, 2 GB
	# by default, checked again by the API. Raise both together.
	handle /api/v1/restores {
		request_body {
			max_size 2100MB
		}
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000
	}

	# JSON never needs to load anything.
	handle /api/* {
		# Uploads are capped here as well as in the API (guide 12.4).
		request_body {
			max_size 210MB
		}
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000 {
			# Server-sent events must not be buffered.
			flush_interval -1
		}
	}

	# The single-page app: guide 12.5's policy. CSP_SCRIPT_SRC stays 'self' in production;
	# the development stack adds 'unsafe-inline' for Vite's hot-reload preamble.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src {$CSP_SCRIPT_SRC:'self'}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:"
		# Vite only answers hosts it knows; present ourselves as its service name so any
		# address that reaches Caddy (localhost, a LAN IP for phone testing) works.
		reverse_proxy web:5173 {
			header_up Host {upstream_hostport}
		}
	}
}
