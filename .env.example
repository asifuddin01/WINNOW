# Copy to .env (`make env` does this and fills in fresh random keys). Never commit .env.
# Guide 16.1. Empty values mean "not configured".

WINNOW_ENV=development            # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# At least 32 bytes; startup fails on this placeholder. `openssl rand -hex 32`
SECRET_KEY=change-me-to-64-random-chars
# Exactly 32 bytes, base64. `openssl rand -base64 32`
ENCRYPTION_KEY=base64-32-bytes

POSTGRES_USER=winnow
POSTGRES_PASSWORD=winnow
POSTGRES_DB=winnow
DATABASE_URL=postgresql+asyncpg://winnow:winnow@db:5432/winnow
REDIS_URL=redis://redis:6379/0
PUBLIC_URL=http://localhost:8080
WINNOW_PORT=8080                  # host port for Caddy in docker-compose.yml

WINNOW_SINGLE_USER=false
REGISTRATION=open                 # open | invite_only | closed
REQUIRE_OWNER_2FA=false           # review owners must use two-factor authentication

STORAGE_BACKEND=local             # local | s3 (s3 arrives with the production setup)
STORAGE_PATH=/data/uploads        # where uploaded files live when STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Winnow <no-reply@example.com>"
SMTP_TLS=starttls                 # starttls | ssl | none (the dev stack uses Mailpit instead)

# "Sign in with Google": an OAuth client of type "Web application" in Google Cloud, with
# the redirect URI {PUBLIC_URL}/api/v1/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Every PDF is scanned by clamd before anyone can open it. `make local` runs without it
# (PDFs are then marked unscanned); empty here does the same.
CLAMAV_HOST=clamav
MAX_PDF_MB=100                    # one PDF; clamd is configured to take streams this size
# "Find free full text": Unpaywall asks for a contact email (PubMed Central does not).
# Set OPEN_ACCESS_LOOKUP=false for an offline install.
UNPAYWALL_EMAIL=
OPEN_ACCESS_LOOKUP=true

LLM_PROVIDER=none                 # none | anthropic | openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

MAX_UPLOAD_MB=200
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
PASSWORD_BREACH_CHECK=true        # k-anonymity lookup in Have I Been Pwned; false offline
